---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../utils/i18n.js';
import type { School } from '../utils/schools';

interface Props {
  school: School;
}

const { school } = Astro.props;
const locale = Astro.currentLocale || 'en';
const schoolUrl = getRelativeLocaleUrl(locale, `schools/${school.slug}`);
const regions = await import('../data/regions.json');
const region = regions.default[school.region];
const country = region?.countries[school.country];
const city = country?.cities[school.city];

const locationName = city?.name?.[locale] || country?.name?.[locale] || school.city;
const countryName = country?.name?.[locale] || school.country;
---

<div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow border border-gray-200 overflow-hidden">
  <a href={schoolUrl} class="block">
    <div class="p-6">
      <!-- School Header -->
      <div class="flex items-start justify-between mb-4">
        <div class="flex-1">
          <h3 class="text-xl font-semibold text-gray-900 mb-2 hover:text-blue-600 transition-colors">
            {school.name}
          </h3>
          <p class="text-sm text-gray-600 flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            {locationName}, {countryName}
          </p>
        </div>
        <!-- Rating -->
        <div class="flex items-center gap-1 text-yellow-500">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
            <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
          </svg>
          <span class="text-gray-900 font-semibold">{school.rating.toFixed(1)}</span>
        </div>
      </div>

      <!-- Certifications -->
      <div class="mb-4">
        <p class="text-xs text-gray-500 mb-2">{t(locale, 'schools.certifications')}:</p>
        <div class="flex flex-wrap gap-2">
          {school.certifications.map(cert => (
            <span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs font-medium rounded">
              {cert}
            </span>
          ))}
        </div>
      </div>

      <!-- Course Types -->
      <div class="mb-4">
        <p class="text-xs text-gray-500 mb-2">{t(locale, 'schools.courseTypes')}:</p>
        <div class="flex flex-wrap gap-2">
          {school.courseTypes.map(type => (
            <span class="px-2 py-1 bg-green-100 text-green-800 text-xs font-medium rounded">
              {t(locale, `common.filters.${type}`)}
            </span>
          ))}
        </div>
      </div>

      <!-- Reviews Count -->
      <div class="flex items-center justify-between pt-4 border-t border-gray-200">
        <span class="text-sm text-gray-600">
          {school.reviewCount} {t(locale, 'schools.reviews')}
        </span>
        <span class="text-blue-600 font-medium text-sm hover:underline">
          {t(locale, 'schools.viewSchool')} →
        </span>
      </div>
    </div>
  </a>
</div>

