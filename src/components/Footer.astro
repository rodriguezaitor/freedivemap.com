---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../utils/i18n.js';

const locale = Astro.currentLocale || 'en';
const homeUrl = getRelativeLocaleUrl(locale);
const aboutUrl = getRelativeLocaleUrl(locale, 'about');
const year = new Date().getFullYear();
---

<footer class="w-full border-t bg-white py-8 mt-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Navigation Links -->
      <div>
        <h3 class="text-sm font-semibold text-gray-900 mb-4">{t(locale, 'common.nav.home')}</h3>
        <nav class="flex flex-col gap-3">
          <a href={homeUrl} class="text-sm text-gray-600 hover:text-blue-600 transition-colors">
        {t(locale, 'common.nav.home')}
      </a>
          <a href={aboutUrl} class="text-sm text-gray-600 hover:text-blue-600 transition-colors">
        {t(locale, 'common.nav.about')}
      </a>
          <a href={getRelativeLocaleUrl(locale, 'contact')} class="text-sm text-gray-600 hover:text-blue-600 transition-colors">
            {t(locale, 'common.footer.contact')}
          </a>
        </nav>
      </div>

      <!-- Legal Links -->
      <div>
        <h3 class="text-sm font-semibold text-gray-900 mb-4">Legal</h3>
        <nav class="flex flex-col gap-3">
          <a href={getRelativeLocaleUrl(locale, 'privacy')} class="text-sm text-gray-600 hover:text-blue-600 transition-colors">
            {t(locale, 'common.footer.privacy')}
          </a>
          <a href={getRelativeLocaleUrl(locale, 'terms')} class="text-sm text-gray-600 hover:text-blue-600 transition-colors">
            {t(locale, 'common.footer.terms')}
          </a>
    </nav>
      </div>

      <!-- SEO Text -->
      <div>
        <p class="text-sm text-gray-600 leading-relaxed">
          {t(locale, 'common.footer.seoText')}
        </p>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-gray-200 pt-6">
      <p class="text-sm text-gray-600 text-center">
        © {year} {t(locale, 'common.footer.copyright')}. All rights reserved.
      </p>
    </div>
  </div>
</footer>


