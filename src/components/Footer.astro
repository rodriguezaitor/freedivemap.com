---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../utils/i18n.js';

const locale = Astro.currentLocale || 'en';
const homeUrl = getRelativeLocaleUrl(locale);
const aboutUrl = getRelativeLocaleUrl(locale, 'about');
const year = new Date().getFullYear();
---

<footer class="w-full border-t bg-white py-6">
  <div class="mx-auto max-w-5xl px-4 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <nav class="flex items-center gap-6 text-sm">
      <a href={homeUrl} class="hover:underline">
        {t(locale, 'common.nav.home')}
      </a>
      <a href={aboutUrl} class="hover:underline">
        {t(locale, 'common.nav.about')}
      </a>
    </nav>
    <p class="text-sm text-gray-600">© {year} Mails.com</p>
  </div>
  
</footer>


