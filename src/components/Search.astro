---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../utils/i18n.js';
import { getAllCities, generateCityUrl } from '../utils/schools';

const locale = Astro.currentLocale || 'en';

// Get all cities for autocomplete
const allCities = getAllCities();

// Create search data for client-side autocomplete (only cities)
const searchData = {
  cities: allCities.map(c => ({
    name: c.name[locale],
    slug: c.city,
    country: c.country,
    region: c.region,
    type: 'city'
  }))
};
---

<div class="relative w-full max-w-2xl mx-auto">
  <form 
    action="#" 
    method="get" 
    class="flex gap-2"
    id="search-form"
  >
    <div class="relative flex-1">
      <input
        type="text"
        name="q"
        id="search-input"
        placeholder={t(locale, 'common.nav.searchPlaceholder') || 'Search by city...'}
        class="w-full px-4 py-3 pl-10 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        autocomplete="off"
      />
      <svg 
        class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" 
        fill="none" 
        stroke="currentColor" 
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
    <button
      type="submit"
      class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors"
    >
      {t(locale, 'common.nav.search')}
    </button>
  </form>

  <!-- Autocomplete dropdown -->
  <div 
    id="autocomplete-results" 
    class="hidden absolute z-50 w-full mt-2 bg-white border border-gray-300 rounded-lg shadow-lg max-h-96 overflow-y-auto"
  >
    <!-- Results will be populated by JavaScript -->
  </div>
</div>

<script define:vars={{ searchData, locale }}>
  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input');
    const autocompleteResults = document.getElementById('autocomplete-results');
    const searchForm = document.getElementById('search-form');

    if (!searchInput || !autocompleteResults || !searchForm) return;
    let selectedIndex = -1;
    let results: Array<{ name: string; url: string; type: string }> = [];

    function getSearchResults(query: string) {
      if (query.length < 2) return [];

      const lowerQuery = query.toLowerCase();
      const matches: Array<{ name: string; url: string; type: string }> = [];

      // Search only cities
      searchData.cities.forEach(city => {
        if (city.name.toLowerCase().includes(lowerQuery)) {
          // Generate city URL using the new structure: /locale/region/country/city
          const cityUrl = `/${locale}/${city.region}/${city.country}/${city.slug}/`;
          matches.push({
            name: city.name,
            url: cityUrl,
            type: 'city'
          });
        }
      });

      return matches.slice(0, 8); // Limit to 8 results
    }

    function renderResults(matches: Array<{ name: string; url: string; type: string }>) {
      if (matches.length === 0) {
        autocompleteResults.classList.add('hidden');
        return;
      }

      results = matches;
      autocompleteResults.innerHTML = matches.map((match, index) => `
        <a 
          href="${match.url}" 
          class="autocomplete-item block px-4 py-3 hover:bg-gray-100 border-b border-gray-200 last:border-b-0 ${index === selectedIndex ? 'bg-gray-100' : ''}"
          data-index="${index}"
        >
          <div class="flex items-center gap-3">
            <span class="text-xs px-2 py-1 bg-blue-100 text-blue-800 rounded">${match.type}</span>
            <span class="text-gray-900">${match.name}</span>
          </div>
        </a>
      `).join('');

      autocompleteResults.classList.remove('hidden');
    }

    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value;
      const matches = getSearchResults(query);
      selectedIndex = -1;
      renderResults(matches);
    });

    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = Math.min(selectedIndex + 1, results.length - 1);
        updateSelection();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, -1);
        updateSelection();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const query = (e.target as HTMLInputElement).value.trim();
        
        // If there's a selected result, use it
        if (selectedIndex >= 0 && results[selectedIndex]) {
          window.location.href = results[selectedIndex].url;
          return;
        }
        
        // If there are visible results, use first one
        if (results.length > 0) {
          window.location.href = results[0].url;
          return;
        }
        
        // If no visible results, search again with current query
        if (query.length >= 2) {
          const matches = getSearchResults(query);
          if (matches.length > 0) {
            window.location.href = matches[0].url;
          }
        }
      } else if (e.key === 'Escape') {
        autocompleteResults.classList.add('hidden');
      }
    });

    // Handle form submission
    if (searchForm) {
      searchForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const query = searchInput.value.trim();
        
        // If there are visible results, use them
        if (selectedIndex >= 0 && results[selectedIndex]) {
          window.location.href = results[selectedIndex].url;
          return;
        }
        
        // If there are results but none selected, use first result
        if (results.length > 0) {
          window.location.href = results[0].url;
          return;
        }
        
        // If no visible results, search again with current query
        if (query.length >= 2) {
          const matches = getSearchResults(query);
          if (matches.length > 0) {
            window.location.href = matches[0].url;
          }
        }
      });
    }

    function updateSelection() {
      const items = autocompleteResults.querySelectorAll('.autocomplete-item');
      items.forEach((item, index) => {
        if (index === selectedIndex) {
          item.classList.add('bg-gray-100');
        } else {
          item.classList.remove('bg-gray-100');
        }
      });
    }

    // Hide autocomplete when clicking outside
    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target as Node) && !autocompleteResults.contains(e.target as Node)) {
        autocompleteResults.classList.add('hidden');
      }
    });
  });
</script>

<style>
  .autocomplete-item {
    transition: background-color 0.15s ease;
  }
</style>

