---
import { getRelativeLocaleUrl } from "astro:i18n";
import { t } from "../utils/i18n.js";
import { Button } from "@/components/ui/button";

const locale = Astro.currentLocale || "en";
const otherLocale = locale === "es" ? "en" : "es";
const otherLocaleUrl = getRelativeLocaleUrl(otherLocale);
const languageKey = `common.languages.${otherLocale}`;
const aboutUrl = getRelativeLocaleUrl(locale, "about");
---

<div class="min-h-screen flex flex-col items-center justify-center bg-gray-50">
  <h1 class="text-4xl font-bold text-gray-900 mb-4">{t(locale, "hello")}</h1>
  <p class="text-lg text-gray-700 mb-2">{t(locale, "description")}</p>
  <p class="text-sm text-gray-600 mb-6">
    {t(locale, "currentLanguage")}: <span class="font-mono">{locale}</span>
  </p>
  <Button variant="default">
    <a href={otherLocaleUrl} data-astro-prefetch="tap">
      🌎 {t(locale, "switchTo")}
      {t(locale, languageKey)}
    </a>
  </Button>
  <a href={aboutUrl} class="mt-4 text-primary underline-offset-4 hover:underline">
    {t(locale, "common.nav.about")}
  </a>
</div>
