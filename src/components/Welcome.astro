---
import { getRelativeLocaleUrl } from "astro:i18n";
import { t } from "../utils/i18n.js";
import { Button } from "@/components/ui/button";

const locale = Astro.currentLocale || "en";
const otherLocale = locale === "es" ? "en" : "es";
const otherLocaleUrl = getRelativeLocaleUrl(otherLocale);
const languageKey = `common.languages.${otherLocale}`;
const aboutUrl = getRelativeLocaleUrl(locale, "about");
---

<div class="min-h-screen flex flex-col items-center justify-center bg-gradient-to-br from-blue-50 via-cyan-50 to-teal-50">
  <div class="text-center px-4 max-w-3xl">
    <h1 class="text-5xl md:text-6xl font-bold text-gray-900 mb-6">
      {t(locale, "hello")}
    </h1>
    <p class="text-xl md:text-2xl text-gray-700 mb-8">
      {t(locale, "description")}
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-8">
      <Button variant="default" class="text-lg px-8 py-6">
        <a href={otherLocaleUrl} data-astro-prefetch="tap" class="flex items-center gap-2">
          🌎 {t(locale, "switchTo")} {t(locale, languageKey)}
        </a>
      </Button>
      <a href={aboutUrl} class="text-lg text-blue-600 hover:text-blue-800 underline-offset-4 hover:underline font-medium">
        {t(locale, "common.nav.about")}
      </a>
    </div>
  </div>
</div>
