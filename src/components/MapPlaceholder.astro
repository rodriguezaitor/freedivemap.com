---
interface Props {
  className?: string;
}

const { className = "h-[400px] w-full rounded-lg" } = Astro.props;
---

<div class={`${className} bg-gray-200 border-2 border-dashed border-gray-400 flex flex-col items-center justify-center`}>
  <svg class="w-16 h-16 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
  </svg>
  <p class="text-gray-500 text-sm font-medium">Map View</p>
  <p class="text-gray-400 text-xs mt-1">Coming soon</p>
</div>

