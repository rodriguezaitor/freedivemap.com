---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { Button } from '@/components/ui/button';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../../utils/i18n.js';
import { getCollection } from 'astro:content';

const locale = Astro.currentLocale || 'en';

// Get all regions from the collection
const allRegions = await getCollection('regions');
const regions = allRegions.map(region => ({
  name: region.data.name[locale],
  description: region.data.description?.[locale] || '',
  url: `/${locale}/${region.id}/`,
  countries: Object.keys(region.data.countries).length,
  slug: region.id,
}));

// Get all destinations from the collection
const allDestinations = await getCollection('destinations');
const destinations = allDestinations.slice(0, 6).map(dest => ({
  name: dest.data.name[locale],
  description: dest.data.description[locale],
  url: `/${locale}/${dest.data.region}/${dest.data.country}/${dest.data.city}/`,
}));
---

<Layout seoKey="home">
  <Header />
  
  <div class="min-h-screen bg-white">
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-blue-50 via-cyan-50 to-teal-50 py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6">
            {t(locale, 'home.hero.title')}
          </h1>
          <p class="text-xl md:text-2xl text-gray-700 mb-8 max-w-3xl mx-auto">
            {t(locale, 'home.hero.subtitle')}
          </p>
          
          <!-- Browse Button -->
          <div class="mb-8">
            <a 
              href="#regions"
              onclick="if(window.dataLayer){window.dataLayer.push({event:'button_click',button_name:'Browse Destinations',button_location:'hero_section',button_url:'#regions'})}"
            >
              <Button variant="default" size="lg" class="text-lg px-8 py-6">
                {locale === 'en' ? 'Browse Destinations' : 'Explorar Destinos'}
              </Button>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Regions Section -->
    <section id="regions" class="py-16 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            {t(locale, 'home.regions.title')}
          </h2>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            {t(locale, 'home.regions.subtitle')}
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {regions.map((region) => (
            <a href={region.url} class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow border border-gray-200 p-6 block">
              <h3 class="text-xl font-semibold text-gray-900 mb-2">{region.name}</h3>
              <p class="text-sm text-gray-600 mb-4 line-clamp-3">{region.description}</p>
              <div class="flex items-center justify-between">
                <span class="text-sm text-blue-600 font-medium">
                  {region.countries} {t(locale, 'home.regions.countries')}
                </span>
                <span class="text-blue-600">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Top Destinations Section -->
    <section class="py-16 bg-gray-50">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            {t(locale, 'home.destinations.title')}
          </h2>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            {t(locale, 'home.destinations.subtitle')}
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {destinations.map((destination) => (
            <a href={destination.url} class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow border border-gray-200 overflow-hidden block">
              <div class="h-48 bg-gradient-to-br from-blue-400 to-cyan-500 flex items-center justify-center">
                <span class="text-4xl">🌊</span>
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-gray-900 mb-2">{destination.name}</h3>
                <p class="text-sm text-gray-600 mb-4">{destination.description}</p>
                <span class="text-blue-600 font-medium text-sm">{t(locale, 'home.destinations.explore')}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- SEO Content Section -->
    <section class="py-16 bg-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <article class="prose prose-lg max-w-none">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">
            {t(locale, 'home.seo.title')}
          </h2>
          <p class="text-gray-700 mb-4 leading-relaxed">
            {t(locale, 'home.seo.intro')}
          </p>
          
          <h3 class="text-2xl font-semibold text-gray-900 mt-8 mb-4">
            {t(locale, 'home.seo.certifications.title')}
          </h3>
          <p class="text-gray-700 mb-4 leading-relaxed">
            {t(locale, 'home.seo.certifications.content')}
          </p>
          
          <h3 class="text-2xl font-semibold text-gray-900 mt-8 mb-4">
            {t(locale, 'home.seo.destinations.title')}
          </h3>
          <p class="text-gray-700 mb-4 leading-relaxed">
            {t(locale, 'home.seo.destinations.content')}
          </p>
          
          <p class="text-gray-700 mb-4 leading-relaxed">
            {t(locale, 'home.seo.cta')}
          </p>
        </article>
      </div>
    </section>
  </div>
</Layout>
