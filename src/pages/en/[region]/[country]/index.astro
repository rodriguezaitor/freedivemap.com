---
export const prerender = false;

import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';
import { getCountryBySlug, getRegionBySlug, generateCityUrl, generateCountryUrl, generateRegionUrl } from '../../../../utils/schools';
import { regions } from '../../../../utils/schools';
import { t } from '../../../../utils/i18n.js';
import { generateFAQSchema, generateBreadcrumbSchema, generateBreadcrumbs } from '../../../../utils/seo';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = Astro.currentLocale || 'en';
const { region: regionSlug, country: countrySlug } = Astro.params;

if (!regionSlug || !countrySlug) {
  return Astro.redirect(getRelativeLocaleUrl(locale, '/'));
}

const region = getRegionBySlug(regionSlug);
const country = getCountryBySlug(regionSlug, countrySlug);

if (!region || !country) {
  return Astro.redirect(getRelativeLocaleUrl(locale, '/'));
}

const regionName = region.name[locale];
const countryName = country.name[locale];

// Get cities in this country
const citiesInCountry = Object.entries(country.cities).map(([slug, city]) => ({
  slug,
  name: city.name[locale]
}));

// Generate FAQ
const faqQuestions = [
  {
    question: t(locale, 'faq.country.q1').replace('{country}', countryName),
    answer: t(locale, 'faq.country.a1')
      .replace('{country}', countryName)
      .replace('{features}', 'excellent freediving conditions, certified schools, and professional instructors')
  },
  {
    question: t(locale, 'faq.country.q2').replace('{country}', countryName),
    answer: t(locale, 'faq.country.a2')
      .replace('{country}', countryName)
      .replace('{price}', '$200-$500')
  },
  {
    question: t(locale, 'faq.country.q3').replace('{country}', countryName),
    answer: t(locale, 'faq.country.a3').replace('{country}', countryName)
  }
];

const faqSchema = generateFAQSchema(faqQuestions);

// Generate breadcrumbs
const breadcrumbs = generateBreadcrumbs(
  locale,
  Astro.site?.toString() || '',
  [
    { name: t(locale, 'common.nav.home'), path: '/' },
    { name: regionName, path: `/${regionSlug}/` },
    { name: countryName, path: `/${regionSlug}/${countrySlug}/` }
  ]
);

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);

// SEO
const seoTitle = `Freediving in ${countryName} — FreeDiveMap`;
const seoDescription = `Discover freediving destinations in ${countryName}. Explore dive sites and plan your next freediving adventure.`;
---

<Layout seoKey="schools" seoOverrides={{ title: seoTitle, description: seoDescription }}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  
  <Header />
  
  <main class="min-h-screen bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      <!-- Breadcrumbs -->
      <nav class="mb-6 text-sm" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2">
          <li><a href={getRelativeLocaleUrl(locale, '/')} class="text-gray-500 hover:text-blue-600">{t(locale, 'common.nav.home')}</a></li>
          <li class="text-gray-400">/</li>
          <li><a href={generateRegionUrl(locale, regionSlug)} class="text-gray-500 hover:text-blue-600">{regionName}</a></li>
          <li class="text-gray-400">/</li>
          <li class="text-gray-900 font-medium">{countryName}</li>
        </ol>
      </nav>

      <!-- Page Header -->
      <div class="mb-8">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Freediving in {countryName}
        </h1>
        <p class="text-lg text-gray-600 leading-relaxed max-w-3xl">
          {countryName} offers excellent freediving destinations with beautiful dive sites and amazing underwater experiences.
        </p>
      </div>

      <!-- Cities in Country -->
      {citiesInCountry.length > 0 && (
        <div class="mb-12">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">Cities in {countryName}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {citiesInCountry.map(city => {
              const cityUrl = generateCityUrl(locale, regionSlug, countrySlug, city.slug);
              return (
                <a 
                  href={cityUrl}
                  class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow border border-gray-200 p-6 block"
                >
                  <h3 class="text-xl font-semibold text-gray-900 mb-2">{city.name}</h3>
                  <p class="text-sm text-gray-600">
                    Explore freediving destinations
                  </p>
                </a>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </main>
</Layout>


