---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';
import Header from '../../../../../components/Header.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../../../../../utils/i18n.js';
import { render } from 'astro:content';
import { marked } from 'marked';

export async function getStaticPaths() {
  const destinations = await getCollection('destinations');
  const regions = await getCollection('regions');
  
  // Filter destinations that have a province
  const destinationsWithProvince = destinations.filter(dest => dest.data.province);
  
  // Create a map of region data for quick lookup
  const regionMap = new Map();
  regions.forEach(region => {
    regionMap.set(region.id, region.data);
  });
  
  return destinationsWithProvince.map((destination) => {
    return {
      params: {
        region: destination.data.region,
        country: destination.data.country,
        province: destination.data.province,
        city: destination.data.city,
      },
      props: {
        destinationId: destination.id,
        regionSlug: destination.data.region,
        countrySlug: destination.data.country,
        provinceSlug: destination.data.province,
        citySlug: destination.data.city,
      },
    };
  });
}

const locale = Astro.currentLocale || 'en';
const { destinationId, regionSlug, countrySlug, provinceSlug, citySlug } = Astro.props;

// Get the destination from the collection
let destination;
try {
  destination = await getEntry('destinations', destinationId);
} catch (error) {
  console.error('Error fetching destination:', error);
  return Astro.redirect(`/${locale}/`);
}

if (!destination) {
  return Astro.redirect(`/${locale}/`);
}

// Get region, country, and province data for breadcrumbs
let region;
let country;
let province;
let cityNameFromRegion: string | undefined;
try {
  region = await getEntry('regions', regionSlug);
  if (region?.data.countries?.[countrySlug]) {
    country = {
      name: region.data.countries[countrySlug].name[locale],
      slug: countrySlug,
    };
    // Get province data
    const provinceData = region.data.countries[countrySlug].provinces?.[provinceSlug];
    if (provinceData) {
      province = {
        name: provinceData.name[locale],
        slug: provinceSlug,
      };
      // Get city name from province data
      cityNameFromRegion = provinceData.cities?.[citySlug]?.name[locale];
    }
  }
} catch (error) {
  console.error('Error fetching region:', error);
}

// Render the destination content - prefer frontmatter content over body
let renderedContent: string | null = null;
let Content;
let headings;
const contentFromFrontmatter = destination.data.content?.[locale];

if (contentFromFrontmatter) {
  // Use content from frontmatter (translated) - render as markdown
  try {
    renderedContent = await marked(contentFromFrontmatter);
  } catch (error) {
    console.error('Error rendering destination content:', error);
  }
} else if (destination.body) {
  // Fallback to body if no frontmatter content
  try {
    const rendered = await render(destination);
    Content = rendered.Content;
    headings = rendered.headings;
  } catch (error) {
    console.error('Error rendering destination:', error);
  }
}

const regionName = region?.data.name[locale] || regionSlug;
// Use city name from region data if available, otherwise use destination name
const cityName = cityNameFromRegion || destination.data.name[locale];
const cityDescription = destination.data.description[locale];
const countryName = country?.name || countrySlug;
const provinceName = province?.name || provinceSlug;

// Build breadcrumbs for JSON-LD schema
const breadcrumbs = [
  { name: locale === 'en' ? 'Home' : 'Inicio', url: `/${locale}/` },
  { name: regionName, url: `/${locale}/${regionSlug}/` },
  { name: countryName, url: `/${locale}/${regionSlug}/${countrySlug}/` },
  { name: provinceName, url: `/${locale}/${regionSlug}/${countrySlug}/${provinceSlug}/` },
  { name: cityName, url: `/${locale}/${regionSlug}/${countrySlug}/${provinceSlug}/${citySlug}/` },
];

// Extract structured data
const schools = destination.data.schools || [];
const diveSites = destination.data.diveSites || [];
const seasonalInfo = destination.data.seasonalInfo || [];
const faq = destination.data.faq || [];
// Auto-generate lastUpdated from build time
const buildDate = new Date();
const lastUpdated = buildDate.toISOString().split('T')[0];
const formattedDate = buildDate.toLocaleDateString(locale === 'en' ? 'en-US' : 'es-ES', { year: 'numeric', month: 'long', day: 'numeric' });

// Build FAQ schema for JSON-LD
const faqSchema = faq.length > 0 ? faq.map((item: any) => ({
  question: item.question[locale],
  answer: item.answer[locale],
})) : null;
---

<Layout 
  seoKey="home"
  seoOverrides={{
    title: `Freediving in ${cityName}, ${provinceName}, ${countryName} | FreediveMap`,
    description: cityDescription
  }}
  whatsappLocation={`${cityName}, ${provinceName}, ${countryName}`}
  breadcrumbs={breadcrumbs}
  faqSchema={faqSchema}
>
  <Header />
  
  <div class="min-h-screen bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      <Breadcrumbs 
        locale={locale}
        region={{ name: regionName, slug: regionSlug }}
        country={country}
        province={province}
        city={{ name: cityName, slug: citySlug }}
      />
      
      <!-- Hero Section -->
      <section class="mb-12">
        <div class="bg-gradient-to-br from-blue-50 via-cyan-50 to-teal-50 rounded-lg p-8 md:p-12">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6">
            {locale === 'en' ? `Freediving in ${cityName}` : `Freediving en ${cityName}`}
          </h1>
          <p class="text-xl md:text-2xl text-gray-700 max-w-3xl">
            {destination.data.description[locale]}
          </p>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-6 text-sm text-gray-500">
            <span class="flex items-center gap-1.5">
              <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" /></svg>
              <span>FreediveMap Team</span>
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
              <time datetime={lastUpdated}>{locale === 'en' ? 'Updated' : 'Actualizado'} {formattedDate}</time>
            </span>
          </div>
        </div>
      </section>

      <!-- Main Content -->
      <section class="prose prose-lg max-w-none">
        {Content && (
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8">
            <Content />
          </div>
        )}
        
        {renderedContent && (
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8" set:html={renderedContent} />
        )}
        
        {!Content && !renderedContent && (
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8">
            <p class="text-gray-600 text-lg">
              {locale === 'en' 
                ? 'More information about this destination will be available soon.' 
                : 'Más información sobre este destino estará disponible pronto.'}
            </p>
          </div>
        )}
      </section>

      <!-- Schools Section -->
      {schools.length > 0 && (
        <section class="mt-16">
          <h2 class="text-3xl font-bold text-gray-900 mb-2">
            {locale === 'en' ? `Freediving Schools in ${cityName}` : `Escuelas de Freediving en ${cityName}`}
          </h2>
          <p class="text-lg text-gray-600 mb-8">
            {locale === 'en' 
              ? `Compare courses, certifications, and prices from freediving schools near ${cityName}.`
              : `Compara cursos, certificaciones y precios de escuelas de freediving cerca de ${cityName}.`}
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {schools.map((school: any) => (
              <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 flex flex-col">
                <h3 class="text-xl font-semibold text-gray-900 mb-1">{school.name}</h3>
                {school.instructor && (
                  <p class="text-sm text-blue-700 font-medium mb-3">
                    {locale === 'en' ? 'Instructor' : 'Instructor'}: {school.instructor}
                  </p>
                )}
                <p class="text-sm text-gray-600 mb-4 flex-grow">{school.description[locale]}</p>
                {school.certifications && school.certifications.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 mb-3">
                    {school.certifications.map((cert: string) => (
                      <span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700 ring-1 ring-blue-700/10 ring-inset">
                        {cert}
                      </span>
                    ))}
                  </div>
                )}
                <div class="flex items-center justify-between mt-auto pt-3 border-t border-gray-100">
                  {school.priceRange && (
                    <span class="text-sm font-semibold text-gray-900">{school.priceRange}</span>
                  )}
                  {school.url && (
                    <a href={school.url} target="_blank" rel="noopener noreferrer" class="text-sm text-blue-600 hover:text-blue-800 font-medium">
                      {locale === 'en' ? 'Visit website' : 'Visitar web'} &rarr;
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Dive Sites Section -->
      {diveSites.length > 0 && (
        <section class="mt-16">
          <h2 class="text-3xl font-bold text-gray-900 mb-2">
            {locale === 'en' ? `Best Dive Sites Near ${cityName}` : `Mejores Sitios de Buceo Cerca de ${cityName}`}
          </h2>
          <p class="text-lg text-gray-600 mb-8">
            {locale === 'en' 
              ? 'Detailed information on the top freediving and apnea spots in the area.'
              : 'Información detallada sobre los mejores puntos de freediving y apnea en la zona.'}
          </p>
          <div class="space-y-4">
            {diveSites.map((site: any) => (
              <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                  <div class="flex-grow">
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">{site.name}</h3>
                    <p class="text-sm text-gray-600 mb-3">{site.description[locale]}</p>
                  </div>
                  <div class="flex flex-wrap gap-3 md:flex-col md:items-end md:gap-2 shrink-0">
                    {site.depth && (
                      <div class="flex items-center gap-1.5">
                        <span class="text-xs font-medium text-gray-500 uppercase tracking-wide">{locale === 'en' ? 'Depth' : 'Prof.'}</span>
                        <span class="inline-flex items-center rounded-md bg-cyan-50 px-2 py-1 text-xs font-medium text-cyan-700 ring-1 ring-cyan-700/10 ring-inset">{site.depth}</span>
                      </div>
                    )}
                    {site.distance && (
                      <div class="flex items-center gap-1.5">
                        <span class="text-xs font-medium text-gray-500 uppercase tracking-wide">{locale === 'en' ? 'Distance' : 'Dist.'}</span>
                        <span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-700 ring-1 ring-gray-700/10 ring-inset">{site.distance}</span>
                      </div>
                    )}
                    {site.level && (
                      <div class="flex items-center gap-1.5">
                        <span class="text-xs font-medium text-gray-500 uppercase tracking-wide">{locale === 'en' ? 'Level' : 'Nivel'}</span>
                        <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-green-700/10 ring-inset">{site.level}</span>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Seasonal Info Section -->
      {seasonalInfo.length > 0 && (
        <section class="mt-16">
          <h2 class="text-3xl font-bold text-gray-900 mb-2">
            {locale === 'en' ? `When to Freedive in ${cityName}` : `Cuándo Hacer Freediving en ${cityName}`}
          </h2>
          <p class="text-lg text-gray-600 mb-8">
            {locale === 'en'
              ? 'Water temperature, visibility, and marine life highlights by season.'
              : 'Temperatura del agua, visibilidad y vida marina destacada por temporada.'}
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {seasonalInfo.map((season: any) => (
              <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-1">{season.season[locale]}</h3>
                <p class="text-sm text-gray-500 mb-4">{season.months}</p>
                <dl class="grid grid-cols-2 gap-3 mb-4">
                  <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">{locale === 'en' ? 'Water Temp' : 'Temp. Agua'}</dt>
                    <dd class="mt-0.5 text-lg font-semibold text-cyan-700">{season.waterTemp}</dd>
                  </div>
                  <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">{locale === 'en' ? 'Visibility' : 'Visibilidad'}</dt>
                    <dd class="mt-0.5 text-lg font-semibold text-cyan-700">{season.visibility}</dd>
                  </div>
                </dl>
                <p class="text-sm text-gray-600">{season.highlights[locale]}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- FAQ Section -->
      {faq.length > 0 && (
        <section class="mt-16">
          <h2 class="text-3xl font-bold text-gray-900 mb-2">
            {locale === 'en' ? `Frequently Asked Questions` : `Preguntas Frecuentes`}
          </h2>
          <p class="text-lg text-gray-600 mb-8">
            {locale === 'en'
              ? `Common questions about freediving in ${cityName}.`
              : `Preguntas comunes sobre freediving en ${cityName}.`}
          </p>
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 divide-y divide-gray-200">
            {faq.map((item: any, index: number) => (
              <details class="group" open={index === 0}>
                <summary class="flex cursor-pointer items-center justify-between gap-4 p-6 text-left font-medium text-gray-900 hover:bg-gray-50 transition-colors [&::-webkit-details-marker]:hidden">
                  <span class="text-base">{item.question[locale]}</span>
                  <svg class="h-5 w-5 shrink-0 text-gray-400 transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </summary>
                <div class="px-6 pb-6 text-sm text-gray-600 leading-relaxed">
                  {item.answer[locale]}
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

      <!-- Location Details Section -->
      <section class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-2xl font-semibold text-gray-900 mb-4">
            {locale === 'en' ? 'Location Details' : 'Detalles de Ubicación'}
          </h2>
          <dl class="space-y-3">
            <div>
              <dt class="text-sm font-medium text-gray-500">
                {locale === 'en' ? 'Region' : 'Región'}
              </dt>
              <dd class="mt-1">
                <a href={`/${locale}/${regionSlug}/`} class="text-blue-600 hover:text-blue-800">
                  {regionName}
                </a>
              </dd>
            </div>
            {country && (
              <div>
                <dt class="text-sm font-medium text-gray-500">
                  {locale === 'en' ? 'Country' : 'País'}
                </dt>
                <dd class="mt-1">
                  <a href={`/${locale}/${regionSlug}/${countrySlug}/`} class="text-blue-600 hover:text-blue-800">
                    {country.name}
                  </a>
                </dd>
              </div>
            )}
            {province && (
              <div>
                <dt class="text-sm font-medium text-gray-500">
                  {locale === 'en' ? 'Province' : 'Provincia'}
                </dt>
                <dd class="mt-1">
                  <a href={`/${locale}/${regionSlug}/${countrySlug}/${provinceSlug}/`} class="text-blue-600 hover:text-blue-800">
                    {province.name}
                  </a>
                </dd>
              </div>
            )}
            <div>
              <dt class="text-sm font-medium text-gray-500">
                {locale === 'en' ? 'City' : 'Ciudad'}
              </dt>
              <dd class="mt-1 text-gray-900">{cityName}</dd>
            </div>
          </dl>
        </div>

        {destination.data.image && (
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
            <div class="h-64 bg-gradient-to-br from-blue-400 to-cyan-500 flex items-center justify-center">
              <span class="text-6xl">🌊</span>
            </div>
          </div>
        )}
      </section>
    </div>
  </div>
</Layout>

