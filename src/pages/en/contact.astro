---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { t } from '../../utils/i18n.js';

const locale = Astro.currentLocale || 'en';
---

<Layout seoKey="contact">
	<Header />
	
	<div class="min-h-screen bg-white">
		<section class="py-16 bg-white">
			<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
				<h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
					{t(locale, 'contact.title')}
				</h1>
				<div class="prose prose-lg max-w-none">
					<p class="text-lg text-gray-700 leading-relaxed mb-8">
						{t(locale, 'contact.description')}
					</p>
					
					<div class="bg-gray-50 rounded-lg p-6 mb-8">
						<h2 class="text-2xl font-semibold text-gray-900 mb-4">
							{t(locale, 'contact.getInTouch.title')}
						</h2>
						<p class="text-lg text-gray-700 leading-relaxed mb-4">
							{t(locale, 'contact.getInTouch.content')}
						</p>
						<p class="text-lg text-gray-700 leading-relaxed">
							<strong>{t(locale, 'contact.email')}:</strong> 
							<a href={`mailto:${t(locale, 'contact.emailAddress')}`} class="text-blue-600 hover:text-blue-800">
								{t(locale, 'contact.emailAddress')}
							</a>
						</p>
					</div>
					
					<h2 class="text-2xl font-semibold text-gray-900 mt-8 mb-4">
						{t(locale, 'contact.feedback.title')}
					</h2>
					<p class="text-lg text-gray-700 leading-relaxed mb-4">
						{t(locale, 'contact.feedback.content')}
					</p>
					
					<h2 class="text-2xl font-semibold text-gray-900 mt-8 mb-4">
						{t(locale, 'contact.support.title')}
					</h2>
					<p class="text-lg text-gray-700 leading-relaxed">
						{t(locale, 'contact.support.content')}
					</p>
				</div>
			</div>
		</section>
	</div>
</Layout>

