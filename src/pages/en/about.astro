---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../utils/i18n.js';

const locale = Astro.currentLocale || 'en';
---

<Layout seoKey="about">
	<section class="min-h-screen flex flex-col items-center justify-center bg-gray-50">
		<h1 class="text-4xl font-bold text-gray-900 mb-4">{t(locale, 'about.title')}</h1>
		<p class="text-lg text-gray-700 mb-2 max-w-prose text-center">{t(locale, 'about.content')}</p>
	</section>
</Layout>



