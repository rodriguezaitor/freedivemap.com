---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import SchoolCard from '../../../components/SchoolCard.astro';
import MapPlaceholder from '../../../components/MapPlaceholder.astro';
import { filterSchools, getAllCountries } from '../../../utils/schools';
import { schools } from '../../../utils/schools';
import { t } from '../../../utils/i18n.js';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = Astro.currentLocale || 'en';
const url = Astro.url;

// Get filter params from URL
const country = url.searchParams.get('country') || '';
const certification = url.searchParams.get('certification') || '';
const courseType = url.searchParams.get('courseType') || '';
const level = url.searchParams.get('level') || '';
const query = url.searchParams.get('q') || '';

// Filter schools
let filteredSchools = filterSchools({
  country: country || undefined,
  certification: certification || undefined,
  courseType: courseType || undefined,
  level: level || undefined
});

// If there's a search query, filter by name
if (query) {
  filteredSchools = filteredSchools.filter(school => 
    school.name.toLowerCase().includes(query.toLowerCase())
  );
}

// Pagination
const pageSize = 12;
const currentPage = parseInt(url.searchParams.get('page') || '1', 10);
const totalPages = Math.ceil(filteredSchools.length / pageSize);
const startIndex = (currentPage - 1) * pageSize;
const paginatedSchools = filteredSchools.slice(startIndex, startIndex + pageSize);

// Get countries for filter dropdown
const countries = getAllCountries().map(c => ({
  value: c.country,
  label: c.name[locale]
}));

// Build pagination pages array
const pagesToShow: number[] = [];
let lastAdded = 0;

for (let i = 1; i <= totalPages; i++) {
  if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
    if (i - lastAdded > 1 && lastAdded > 0) {
      pagesToShow.push(-1); // -1 means ellipsis
    }
    pagesToShow.push(i);
    lastAdded = i;
  }
}

---

<Layout seoKey="schools">
  <Header />
  
  <main class="min-h-screen bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      <!-- Page Header -->
      <div class="mb-8">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          {t(locale, 'schools.title')}
        </h1>
        <p class="text-lg text-gray-600">
          {t(locale, 'schools.description')}
        </p>
      </div>

      <!-- Filters (will be enhanced with React component on client) -->
      <div class="mb-6">
        <div class="bg-white p-4 rounded-lg border border-gray-200">
          <form method="get" class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                {t(locale, 'common.filters.country')}
              </label>
              <select
                name="country"
                class="w-full px-3 py-2 border border-gray-300 rounded-md"
              >
                <option value="">{t(locale, 'common.filters.all')}</option>
                {countries.map(countryOption => (
                  <option value={countryOption.value} selected={countryOption.value === country}>
                    {countryOption.label}
                  </option>
                ))}
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                {t(locale, 'common.filters.certification')}
              </label>
              <select name="certification" class="w-full px-3 py-2 border border-gray-300 rounded-md">
                <option value="">{t(locale, 'common.filters.all')}</option>
                <option value="AIDA" selected={certification === 'AIDA'}>{t(locale, 'common.filters.aida')}</option>
                <option value="SSI" selected={certification === 'SSI'}>{t(locale, 'common.filters.ssi')}</option>
                <option value="Molchanovs" selected={certification === 'Molchanovs'}>{t(locale, 'common.filters.molchanovs')}</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                {t(locale, 'common.filters.courseType')}
              </label>
              <select name="courseType" class="w-full px-3 py-2 border border-gray-300 rounded-md">
                <option value="">{t(locale, 'common.filters.all')}</option>
                <option value="beginner" selected={courseType === 'beginner'}>{t(locale, 'common.filters.beginner')}</option>
                <option value="depth" selected={courseType === 'depth'}>{t(locale, 'common.filters.depth')}</option>
                <option value="fun" selected={courseType === 'fun'}>{t(locale, 'common.filters.fun')}</option>
              </select>
            </div>
            <div class="flex items-end">
              <button
                type="submit"
                class="w-full px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700"
              >
                {t(locale, 'common.nav.search')}
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Results Count -->
      <div class="mb-6 text-sm text-gray-600">
        {t(locale, 'common.pagination.showing')} {filteredSchools.length} {t(locale, 'common.pagination.results')}
      </div>

      <!-- Two Column Layout: Map + Schools -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Map -->
        <div class="order-2 lg:order-1">
          <div class="sticky top-20">
            <MapPlaceholder className="h-[600px] w-full rounded-lg" />
          </div>
        </div>

        <!-- Schools List -->
        <div class="order-1 lg:order-2">
          {paginatedSchools.length > 0 ? (
            <>
              <div class="grid grid-cols-1 gap-6 mb-8">
                {paginatedSchools.map(school => (
                  <SchoolCard school={school} />
                ))}
              </div>

              <!-- Pagination -->
              {totalPages > 1 && (
                <nav class="flex items-center justify-between border-t border-gray-200 pt-6">
                  <div class="flex-1 flex justify-between sm:hidden">
                    {currentPage > 1 && (
                      <a
                        href={getRelativeLocaleUrl(locale, `schools?page=${currentPage - 1}${country ? `&country=${country}` : ''}${certification ? `&certification=${certification}` : ''}${courseType ? `&courseType=${courseType}` : ''}`)}
                        class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50"
                      >
                        {t(locale, 'common.pagination.previous')}
                      </a>
                    )}
                    {currentPage < totalPages && (
                      <a
                        href={getRelativeLocaleUrl(locale, `schools?page=${currentPage + 1}${country ? `&country=${country}` : ''}${certification ? `&certification=${certification}` : ''}${courseType ? `&courseType=${courseType}` : ''}`)}
                        class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50"
                      >
                        {t(locale, 'common.pagination.next')}
                      </a>
                    )}
                  </div>
                  <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                    <div>
                      <p class="text-sm text-gray-700">
                        {t(locale, 'common.pagination.page')} <span class="font-medium">{currentPage}</span> {t(locale, 'common.pagination.of')} <span class="font-medium">{totalPages}</span>
                      </p>
                    </div>
                    <div>
                      <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                        {currentPage > 1 && (
                          <a
                            href={getRelativeLocaleUrl(locale, `schools?page=${currentPage - 1}${country ? `&country=${country}` : ''}${certification ? `&certification=${certification}` : ''}${courseType ? `&courseType=${courseType}` : ''}`)}
                            class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50"
                          >
                            {t(locale, 'common.pagination.previous')}
                          </a>
                        )}
                        {pagesToShow.map((pageNum) => {
                          if (pageNum === -1) {
                            return <span class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700">...</span>;
                          }
                          return (
                            <a
                              href={getRelativeLocaleUrl(locale, `schools?page=${pageNum}${country ? `&country=${country}` : ''}${certification ? `&certification=${certification}` : ''}${courseType ? `&courseType=${courseType}` : ''}`)}
                              class={`relative inline-flex items-center px-4 py-2 border text-sm font-medium ${
                                pageNum === currentPage
                                  ? 'z-10 bg-blue-50 border-blue-500 text-blue-600'
                                  : 'bg-white border-gray-300 text-gray-500 hover:bg-gray-50'
                              }`}
                            >
                              {pageNum}
                            </a>
                          );
                        })}
                        {currentPage < totalPages && (
                          <a
                            href={getRelativeLocaleUrl(locale, `schools?page=${currentPage + 1}${country ? `&country=${country}` : ''}${certification ? `&certification=${certification}` : ''}${courseType ? `&courseType=${courseType}` : ''}`)}
                            class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50"
                          >
                            {t(locale, 'common.pagination.next')}
                          </a>
                        )}
                      </nav>
                    </div>
                  </div>
                </nav>
              )}
            </>
          ) : (
            <div class="text-center py-12">
              <p class="text-gray-600 text-lg">{t(locale, 'schools.noResults')}</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </main>
</Layout>

