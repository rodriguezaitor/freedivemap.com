---
export const prerender = false;

import Layout from '../../../../../../layouts/Layout.astro';
import Header from '../../../../../../components/Header.astro';
import SchoolCard from '../../../../../../components/SchoolCard.astro';
import { getSchoolsByCity, getCityBySlug, getCountryBySlug, getRegionBySlug, generateCityUrl, generateCountryUrl, generateRegionUrl } from '../../../../../../utils/schools';
import { regions } from '../../../../../../utils/schools';
import { t } from '../../../../../../utils/i18n.js';
import { generateFAQSchema, generateBreadcrumbSchema, generateBreadcrumbs } from '../../../../../../utils/seo';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = Astro.currentLocale || 'en';
const { region: regionSlug, country: countrySlug, city: citySlug } = Astro.params;

if (!regionSlug || !countrySlug || !citySlug) {
  return Astro.redirect(getRelativeLocaleUrl(locale, 'schools'));
}

const region = getRegionBySlug(regionSlug);
const country = getCountryBySlug(regionSlug, countrySlug);
const city = getCityBySlug(regionSlug, countrySlug, citySlug);

if (!region || !country || !city) {
  return Astro.redirect(getRelativeLocaleUrl(locale, 'schools'));
}

const regionName = region.name[locale];
const countryName = country.name[locale];
const cityName = city.name[locale];
const schoolsInCity = getSchoolsByCity(citySlug);

// Generate FAQ
const faqQuestions = [
  {
    question: t(locale, 'faq.city.q1').replace('{city}', cityName),
    answer: t(locale, 'faq.city.a1')
      .replace('{city}', cityName)
      .replace('{features}', 'excellent visibility, warm waters, and professional training facilities')
  },
  {
    question: t(locale, 'faq.city.q2').replace('{city}', cityName),
    answer: t(locale, 'faq.city.a2')
      .replace('{city}', cityName)
      .replace('{priceRange}', '$200-$500')
  },
  {
    question: t(locale, 'faq.city.q3'),
    answer: t(locale, 'faq.city.a3')
  }
];

const faqSchema = generateFAQSchema(faqQuestions);

// Generate breadcrumbs
const breadcrumbs = generateBreadcrumbs(
  locale,
  Astro.site?.toString() || '',
  [
    { name: t(locale, 'common.nav.home'), path: '/' },
    { name: t(locale, 'schools.title'), path: '/schools/' },
    { name: regionName, path: `/schools/${regionSlug}/` },
    { name: countryName, path: `/schools/${regionSlug}/${countrySlug}/` },
    { name: cityName, path: `/schools/${regionSlug}/${countrySlug}/${citySlug}/` }
  ]
);

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);

// SEO
const seoTitle = `Freediving Schools in ${cityName}, ${countryName} — FreeDiveMap`;
const seoDescription = `Find certified freediving schools in ${cityName}, ${countryName}. Browse courses, read reviews, and find the perfect training center.`;
---

<Layout seoKey="schools" seoOverrides={{ title: seoTitle, description: seoDescription }}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  
  <Header />
  
  <main class="min-h-screen bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      <!-- Breadcrumbs -->
      <nav class="mb-6 text-sm" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2">
          <li><a href={getRelativeLocaleUrl(locale, '/')} class="text-gray-500 hover:text-blue-600">{t(locale, 'common.nav.home')}</a></li>
          <li class="text-gray-400">/</li>
          <li><a href={getRelativeLocaleUrl(locale, 'schools')} class="text-gray-500 hover:text-blue-600">{t(locale, 'schools.title')}</a></li>
          <li class="text-gray-400">/</li>
          <li><a href={generateRegionUrl(locale, regionSlug)} class="text-gray-500 hover:text-blue-600">{regionName}</a></li>
          <li class="text-gray-400">/</li>
          <li><a href={generateCountryUrl(locale, regionSlug, countrySlug)} class="text-gray-500 hover:text-blue-600">{countryName}</a></li>
          <li class="text-gray-400">/</li>
          <li class="text-gray-900 font-medium">{cityName}</li>
        </ol>
      </nav>

      <!-- Page Header -->
      <div class="mb-8">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Freediving Schools in {cityName}
        </h1>
        <p class="text-lg text-gray-600 leading-relaxed max-w-3xl">
          {cityName} is an excellent destination for freediving with {schoolsInCity.length} {schoolsInCity.length === 1 ? 'certified school' : 'certified schools'} 
          offering professional training for all levels. Whether you're a beginner or experienced freediver, 
          you'll find the perfect course to enhance your skills.
        </p>
      </div>

      <!-- Schools in City -->
      <div class="mb-12">
        <h2 class="text-2xl font-semibold text-gray-900 mb-6">
          Schools in {cityName}
        </h2>
        {schoolsInCity.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {schoolsInCity.map(school => (
              <SchoolCard school={school} />
            ))}
          </div>
        ) : (
          <p class="text-gray-600">{t(locale, 'schools.noResults')}</p>
        )}
      </div>

      <!-- FAQ Section -->
      <div class="bg-white rounded-lg shadow-md p-8 mb-8">
        <h2 class="text-2xl font-semibold text-gray-900 mb-6">Frequently Asked Questions</h2>
        <div class="space-y-6">
          {faqQuestions.map((qa, index) => (
            <div key={index}>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">{qa.question}</h3>
              <p class="text-gray-700 leading-relaxed">{qa.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </main>
</Layout>

