---
import Home from '../../components/Home.astro';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { generateOrganizationSchema } from '../../utils/seo';
---

<Layout seoKey="home">
	{(() => {
		const orgSchema = generateOrganizationSchema(Astro.site?.toString() || 'https://freedivemap.com');
		return <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />;
	})()}
	<Header />
	<Home />
</Layout>


