---
import Home from '../../components/Home.astro';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { generateOrganizationSchema } from '../../utils/seo';
---

<Layout seoKey="home">
	{(() => {
		// Safely convert Astro.site to string for Cloudflare Workers compatibility
		const siteUrl = Astro.site ? String(Astro.site) : Astro.url.origin;
		const orgSchema = generateOrganizationSchema(siteUrl);
		return <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />;
	})()}
	<Header />
	<Home />
</Layout>


