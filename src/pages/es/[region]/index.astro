---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import { getRegionBySlug, generateCountryUrl, generateRegionUrl } from '../../../utils/schools';
import { regions } from '../../../utils/schools';
import { t } from '../../../utils/i18n.js';
import { generateFAQSchema, generateBreadcrumbSchema, generateBreadcrumbs } from '../../../utils/seo';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = Astro.currentLocale || 'en';
const { region: regionSlug } = Astro.params;

if (!regionSlug) {
  return Astro.redirect(getRelativeLocaleUrl(locale, '/'));
}

const region = getRegionBySlug(regionSlug);
if (!region) {
  return Astro.redirect(getRelativeLocaleUrl(locale, '/'));
}

const regionName = region.name[locale];

// Get unique countries in this region
const countriesInRegion = Object.entries(region.countries).map(([slug, country]) => ({
  slug,
  name: country.name[locale],
  cityCount: Object.keys(country.cities || {}).length
}));

// Generate FAQ
const faqQuestions = [
  {
    question: t(locale, 'faq.region.q1').replace('{region}', regionName),
    answer: t(locale, 'faq.region.a1')
      .replace('{region}', regionName)
      .replace('{destinations}', countriesInRegion.slice(0, 3).map(c => c.name).join(', '))
  },
  {
    question: t(locale, 'faq.region.q2'),
    answer: t(locale, 'faq.region.a2')
  },
  {
    question: t(locale, 'faq.region.q3'),
    answer: t(locale, 'faq.region.a3')
  }
];

const faqSchema = generateFAQSchema(faqQuestions);

// Generate breadcrumbs
// Safely convert Astro.site to string for Cloudflare Workers compatibility
const siteUrl = Astro.site ? String(Astro.site) : Astro.url.origin;
const breadcrumbs = generateBreadcrumbs(
  locale,
  siteUrl,
  [
    { name: t(locale, 'common.nav.home'), path: '/' },
    { name: regionName, path: `/${regionSlug}/` }
  ]
);

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);

// SEO
const seoTitle = `Freediving en ${regionName} — FreeDiveMap`;
const seoDescription = t(locale, `regions.${regionSlug}.description`);
---

<Layout seoKey="schools" seoOverrides={{ title: seoTitle, description: seoDescription }}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  
  <Header />
  
  <main class="min-h-screen bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      <!-- Breadcrumbs -->
      <nav class="mb-6 text-sm" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2">
          <li><a href={getRelativeLocaleUrl(locale, '/')} class="text-gray-500 hover:text-blue-600">{t(locale, 'common.nav.home')}</a></li>
          <li class="text-gray-400">/</li>
          <li class="text-gray-900 font-medium">{regionName}</li>
        </ol>
      </nav>

      <!-- Page Header -->
      <div class="mb-8">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Freediving en {regionName}
        </h1>
        <p class="text-lg text-gray-600 leading-relaxed max-w-3xl">
          {t(locale, `regions.${regionSlug}.description`)}
        </p>
      </div>

      <!-- Countries in Region -->
      {countriesInRegion.length > 0 && (
        <div class="mb-12">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">Países en {regionName}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {countriesInRegion.map(country => {
              const countryUrl = generateCountryUrl(locale, regionSlug, country.slug);
              return (
                <a 
                  href={countryUrl}
                  class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow border border-gray-200 p-6 block"
                >
                  <h3 class="text-xl font-semibold text-gray-900 mb-2">{country.name}</h3>
                  <p class="text-sm text-gray-600">
                    {country.cityCount} {country.cityCount === 1 ? 'ciudad' : 'ciudades'}
                  </p>
                </a>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </main>
</Layout>


