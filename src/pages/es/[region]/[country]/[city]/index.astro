---
export const prerender = false;

import Layout from "../../../../../layouts/Layout.astro";
import Header from "../../../../../components/Header.astro";
import {
  getCityBySlug,
  getCountryBySlug,
  getRegionBySlug,
  generateCityUrl,
  generateCountryUrl,
  generateRegionUrl,
} from "../../../../../utils/schools";
import { regions } from "../../../../../utils/schools";
import { t } from "../../../../../utils/i18n.js";
import {
  generateFAQSchema,
  generateBreadcrumbSchema,
  generateBreadcrumbs,
} from "../../../../../utils/seo";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale || "en";
const {
  region: regionSlug,
  country: countrySlug,
  city: citySlug,
} = Astro.params;

if (!regionSlug || !countrySlug || !citySlug) {
  return Astro.redirect(getRelativeLocaleUrl(locale, "/"));
}

const region = getRegionBySlug(regionSlug);
const country = getCountryBySlug(regionSlug, countrySlug);
const city = getCityBySlug(regionSlug, countrySlug, citySlug);

if (!region || !country || !city) {
  return Astro.redirect(getRelativeLocaleUrl(locale, "/"));
}

const regionName = region.name[locale];
const countryName = country.name[locale];
const cityName = city.name[locale];

// Generate FAQ
const faqQuestions = [
  {
    question: t(locale, "faq.city.q1").replace("{city}", cityName),
    answer: t(locale, "faq.city.a1")
      .replace("{city}", cityName)
      .replace(
        "{features}",
        "excelente visibilidad, aguas cálidas e instalaciones de entrenamiento profesionales"
      ),
  },
  {
    question: t(locale, "faq.city.q2").replace("{city}", cityName),
    answer: t(locale, "faq.city.a2")
      .replace("{city}", cityName)
      .replace("{priceRange}", "$200-$500"),
  },
  {
    question: t(locale, "faq.city.q3"),
    answer: t(locale, "faq.city.a3"),
  },
];

const faqSchema = generateFAQSchema(faqQuestions);

// Generate breadcrumbs
const breadcrumbs = generateBreadcrumbs(locale, Astro.site?.toString() || "", [
  { name: t(locale, "common.nav.home"), path: "/" },
  { name: regionName, path: `/${regionSlug}/` },
  { name: countryName, path: `/${regionSlug}/${countrySlug}/` },
  { name: cityName, path: `/${regionSlug}/${countrySlug}/${citySlug}/` },
]);

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);

// SEO
const seoTitle = `Freediving en ${cityName}, ${countryName} — FreeDiveMap`;
const seoDescription = `Descubre destinos de freediving en ${cityName}, ${countryName}. Explora sitios de buceo y planifica tu próxima aventura de freediving.`;
---

<Layout
  seoKey="schools"
  seoOverrides={{ title: seoTitle, description: seoDescription }}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <Header />

  <main class="min-h-screen bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      <!-- Breadcrumbs -->
      <nav class="mb-6 text-sm" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2">
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "/")}
              class="text-gray-500 hover:text-blue-600"
              >{t(locale, "common.nav.home")}</a
            >
          </li>
          <li class="text-gray-400">/</li>
          <li>
            <a
              href={generateRegionUrl(locale, regionSlug)}
              class="text-gray-500 hover:text-blue-600">{regionName}</a
            >
          </li>
          <li class="text-gray-400">/</li>
          <li>
            <a
              href={generateCountryUrl(locale, regionSlug, countrySlug)}
              class="text-gray-500 hover:text-blue-600">{countryName}</a
            >
          </li>
          <li class="text-gray-400">/</li>
          <li class="text-gray-900 font-medium">{cityName}</li>
        </ol>
      </nav>

      <!-- Page Header -->
      <div class="mb-8">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Freediving en {cityName}
        </h1>
        <p class="text-lg text-gray-600 leading-relaxed max-w-3xl">
          {cityName} es un excelente destino para freediving con hermosos sitios
          de buceo y experiencias submarinas increíbles.
        </p>
      </div>

      <!-- FAQ Section -->
      <div class="bg-white rounded-lg shadow-md p-8 mb-8">
        <h2 class="text-2xl font-semibold text-gray-900 mb-6">
          Preguntas Frecuentes
        </h2>
        <div class="space-y-6">
          {
            faqQuestions.map((qa, index) => (
              <div key={index}>
                <h3 class="text-lg font-semibold text-gray-900 mb-2">
                  {qa.question}
                </h3>
                <p class="text-gray-700 leading-relaxed">{qa.answer}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </main>
</Layout>
