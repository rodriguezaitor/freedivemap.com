---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import { t } from '../../../utils/i18n.js';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = Astro.currentLocale || 'en';
---

<Layout seoKey="addSchool" noindex={true}>
  <meta name="robots" content="nofollow" />
  
  <Header />
  
  <main class="min-h-screen bg-gray-50">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12">
      <div class="bg-white rounded-lg shadow-md p-8">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          {t(locale, 'addSchool.title')}
        </h1>
        <p class="text-lg text-gray-600 mb-8">
          {t(locale, 'addSchool.description')}
        </p>

        <form class="space-y-6" method="post" action="#">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
              {t(locale, 'addSchool.form.name')} *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="country" class="block text-sm font-medium text-gray-700 mb-2">
                {t(locale, 'addSchool.form.country')} *
              </label>
              <input
                type="text"
                id="country"
                name="country"
                required
                class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
            </div>

            <div>
              <label for="city" class="block text-sm font-medium text-gray-700 mb-2">
                {t(locale, 'addSchool.form.city')} *
              </label>
              <input
                type="text"
                id="city"
                name="city"
                required
                class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
            </div>
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
              {t(locale, 'addSchool.form.email')} *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>

          <div>
            <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
              {t(locale, 'addSchool.form.phone')}
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>

          <div>
            <label for="website" class="block text-sm font-medium text-gray-700 mb-2">
              {t(locale, 'addSchool.form.website')}
            </label>
            <input
              type="url"
              id="website"
              name="website"
              class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>

          <div>
            <label for="certifications" class="block text-sm font-medium text-gray-700 mb-2">
              {t(locale, 'addSchool.form.certifications')}
            </label>
            <div class="space-y-2">
              <label class="flex items-center">
                <input type="checkbox" name="certifications" value="AIDA" class="mr-2" />
                <span>AIDA</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" name="certifications" value="SSI" class="mr-2" />
                <span>SSI</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" name="certifications" value="Molchanovs" class="mr-2" />
                <span>Molchanovs</span>
              </label>
            </div>
          </div>

          <div>
            <button
              type="submit"
              class="w-full px-6 py-3 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 font-medium"
            >
              {t(locale, 'addSchool.form.submit')}
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
</Layout>

